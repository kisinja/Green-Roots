generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  //url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  password  String
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())
  orders    Order[]
  reviews   Review[]
}

enum Role {
  CUSTOMER
  ADMIN
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  emoji    String
  products Product[]
}

model Product {
  id   String @id @default(cuid())
  name String
  slug String @unique

  description     String
  longDescription String?

  price Float
  stock Int   @default(0)

  images String[] @default([])

  emoji String
  badge String?

  featured Boolean @default(false)

  features       String[] @default([])
  specifications Json?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())

  orderItems OrderItem[]
  reviews    Review[]

  averageRating Float @default(0)
  reviewCount   Int   @default(0)
}

model Order {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  name String
  status      OrderStatus @default(PENDING)
  totalAmount Float
  phone       String
  address     String
  mpesaRef    String?
  waMessage   Boolean     @default(false)
  items       OrderItem[]

  payment Payment?

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  DELIVERED
  CANCELLED
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}

model Review {
  id String @id @default(cuid())

  rating  Int // 1-5
  comment String?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  verifiedPurchase Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // prevent one user from reviewing the same product multiple times
  @@unique([userId, productId])
}

model Payment {
  id          String   @id @default(cuid())

  orderId     String @unique
  order       Order    @relation(fields: [orderId], references: [id])

  provider    String
  status      PaymentStatus @default(PENDING)

  amount      Float
  currency    String @default("KES")

  phone       String?
  providerRef String?
  name String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model BlogPost {
  id      String @id @default(cuid())
  title   String
  slug    String @unique
  excerpt String
  content String @db.Text

  coverImage String?
  featured   Boolean @default(false)
  published  Boolean @default(false)

  tags String[] @default([])

  seoTitle       String?
  seoDescription String?
  seoKeywords    String[] @default([])

  readTime Int? // in minutes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // For future expansion, we can add an author relation to the User model if we want to support multiple authors for blog posts. For now, we'll keep it simple without an author field.

  /**
   * authorId String?
   * author   User?   @relation(fields: [authorId], references: [id])
   */
}

model CropGuide {
  id String @id @default(cuid())

  cropName  String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cropName])
}

model DiseaseGuide {
  id String @id @default(cuid())

  diseaseName String
  symptoms    String @db.Text
  treatment   String @db.Text
  prevention  String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([diseaseName])
}

model AIConversation {
  id String @id @default(cuid())

  userId String?
  title  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages AIMessage[]
}

model AIMessage {
  id String @id @default(cuid())

  conversationId String

  role String

  content String @db.Text

  createdAt    DateTime       @default(now())
  conversation AIConversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
}
